<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Secure Player</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>secure_player</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- Encryption use is limited to the exempt categories: standard TLS/HTTPS
	     (cert_pinning_service.dart) and standard, non-authored algorithms
	     (AES-128-CBC, AES-256-GCM, HKDF-SHA256) used solely for video
	     copy-protection/DRM — both exempt under EAR, no export documentation
	     required. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<!-- Only the photo-library string is declared, and it describes a real
	     feature: attaching an image to a question in a personal quiz
	     (personal_quiz_editor_screen.dart's _pickImage).
	     Camera and location strings were deliberately removed. Nothing on
	     iOS uses either: there is no camera or location API anywhere in the
	     Dart code, and the in-app HTML viewer that could theoretically
	     request them via WebKit has no iOS code path at all
	     (html_file_viewer.dart branches only on Platform.isWindows /
	     Platform.isAndroid). The previous strings said, in effect, "the app
	     does not use this" — exactly the vague, non-committal phrasing
	     Guideline 5.1.1(i) rejects, and declaring capabilities the app never
	     exercises also invites avoidable reviewer scrutiny and complicates
	     the App Privacy questionnaire.
	     If a future upload ever returns ITMS-90683 naming one of these keys,
	     that is an upload-validation message that names the exact key and is
	     fixed in minutes — a far cheaper failure than a review rejection
	     over an unconvincing purpose string. -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Lets you choose an image from your device to attach to a question in your own personal quiz. Images stay on your device.</string>
</dict>
</plist>
