<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Secure Player</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>secure_player</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- Encryption use is limited to the exempt categories: standard TLS/HTTPS
	     (cert_pinning_service.dart) and standard, non-authored algorithms
	     (AES-128-CBC, AES-256-GCM, HKDF-SHA256) used solely for video
	     copy-protection/DRM — both exempt under EAR, no export documentation
	     required. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- UIBackgroundModes is deliberately ABSENT. Do not re-add "audio".
	     It arrived with the initial Flutter/better_player scaffold (better_player's
	     own setup docs tell you to add it) and sat here unused until Apple rejected
	     build 300 under Guideline 2.5.4: the app declared background audio but has
	     no feature that plays anything once it leaves the foreground.
	     Nor should it. This is a DRM-protected video app with screen-capture
	     blocking — audio continuing with the screen locked is a leak path, not a
	     feature. Removing the key does NOT affect playback: foreground sound comes
	     from the AVAudioSession *category*, set in code and entirely separate
	     (AudioSyncChannel.swift setCategory(.playback), BetterPlayer.swift likewise).
	     If background playback is ever genuinely wanted, adding the key back is not
	     enough — Apple requires a screen recording of the feature working on a
	     physical device, attached in App Review Information. -->
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<!-- All three strings are required and all three describe real behaviour.
	     Do not remove the camera or location strings again.

	     History, so this is not re-litigated: they were deleted in e8176d7 on
	     the stated grounds that "the in-app HTML viewer has no iOS code path
	     at all (html_file_viewer.dart branches only on Windows/Android)".
	     That was simply wrong — it cited a path that does not exist, and the
	     real viewer does run on iOS:
	       lib/shared/webview_session.dart:121  if (Platform.isAndroid || Platform.isIOS)
	       lib/shared/html_file_viewer.dart:165 suppressTransientHold: Platform.isIOS
	     Course materials open in a WKWebView, and any page inside it can ask
	     for camera or location. Deleting the strings produced ITMS-90683 on
	     upload and had to be reverted.

	     NSPhotoLibraryUsageDescription covers a first-party feature: attaching
	     an image to a question in a personal quiz
	     (personal_quiz_editor_screen.dart's _pickImage). -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Lets you choose an image from your device to attach to a question in your own personal quiz. Images stay on your device.</string>
<key>NSCameraUsageDescription</key>
<string>Some course materials open in an in-app browser that may ask to use the camera. Secure Player never records photos or video on its own, and you are always asked before any access is granted.</string>

<!-- الموقع (لحل رسالة التنبيه) -->
<key>NSLocationWhenInUseUsageDescription</key>
<string>Some course materials open in an in-app browser that may ask for your location. Secure Player never collects or stores location data, and you are always asked before any access is granted.</string>

</dict>
</plist>
